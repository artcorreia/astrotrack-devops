{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VeiculoResponse",
  "type": "object",
  "required": ["idVeiculo", "placa", "modelo", "marca", "ano", "status"],
  "additionalProperties": false,
  "properties": {
    "idVeiculo": { "type": "integer", "minimum": 1 },
    "placa": { "type": "string", "pattern": "^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$" },
    "modelo": { "type": "string", "maxLength": 80 },
    "marca": { "type": "string", "maxLength": 60 },
    "ano": { "type": "integer", "minimum": 1980, "maximum": 2100 },
    "status": { "type": "string", "enum": ["DISPONIVEL", "EM_MANUTENCAO", "EM_VIAGEM", "INATIVO"] }
  }
}
