# Copie este arquivo para .env e preencha com os valores reais:
#   cp .env.example .env
# O .env é ignorado pelo git; NUNCA commite segredos.
#
# O ASP.NET Core lê variáveis de ambiente por cima do appsettings.json.
# O separador "__" (dois underscores) equivale ao ":" da hierarquia do JSON:
#   ConnectionStrings__OracleConnection -> ConnectionStrings:OracleConnection

# ─── Banco Oracle (container "oracle" do docker-compose) ────────────────────
# Senha dos usuários administrativos (SYS/SYSTEM) do Oracle
ORACLE_PASSWORD=troque_esta_senha_admin
# Usuário/schema da aplicação, criado no FREEPDB1 na primeira inicialização.
# Use só letras, números e "_" (a senha entra na connection string).
APP_USER=astrotrack
APP_USER_PASSWORD=troque_esta_senha

# ─── API (.NET) ──────────────────────────────────────────────────────────────
# No docker-compose a connection string é montada a partir de APP_USER e
# APP_USER_PASSWORD (Data Source=oracle:1521/FREEPDB1). Esta variável só é
# usada ao rodar a API fora do Docker (dotnet run). Obs.: o compose não publica
# a porta 1521 no host; para usar o Oracle do container no dotnet run, adicione
# ports: ["1521:1521"] ao serviço oracle.
ConnectionStrings__OracleConnection=User Id=astrotrack;Password=troque_esta_senha;Data Source=localhost:1521/FREEPDB1

# Mínimo de 32 caracteres (HMAC-SHA256). Gere uma com: openssl rand -base64 48
Jwt__Key=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
Jwt__Issuer=AstroTrack
Jwt__Audience=AstroTrackUsers

# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Porta do HOST onde a API fica acessível (http://localhost:PORT).
# Dentro do container a API sempre escuta na 8080.
PORT=8080

# Obs.: RUN_MIGRATIONS=true é definido direto no docker-compose.yml, para a API
# aplicar as migrations do EF Core ao subir.
