# Copie este arquivo para .env e preencha com os valores reais.
# O .env é ignorado pelo git; NUNCA commite segredos.
#
# O ASP.NET Core lê variáveis de ambiente por cima do appsettings.json.
# O separador "__" (dois underscores) equivale ao ":" da hierarquia do JSON:
#   ConnectionStrings__OracleConnection -> ConnectionStrings:OracleConnection

# ─── Aplicação (.NET) ────────────────────────────────────────────────────────
ConnectionStrings__OracleConnection=User Id=astrotrack;Password=troque_esta_senha;Data Source=oracle:1521/FREEPDB1

# Mínimo de 32 caracteres (HMAC-SHA256). Gere uma com: openssl rand -base64 48
Jwt__Key=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
Jwt__Issuer=AstroTrack
Jwt__Audience=AstroTrackUsers

# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Porta exposta pela API (usada no docker-compose)
PORT=8080

# ─── Banco Oracle (container do docker-compose) ─────────────────────────────
# Senha dos usuários administrativos (SYS/SYSTEM) do Oracle
ORACLE_PASSWORD=troque_esta_senha_admin
# Usuário/schema da aplicação, criado na inicialização do container
APP_USER=astrotrack
APP_USER_PASSWORD=troque_esta_senha
