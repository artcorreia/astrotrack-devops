{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthResponse",
  "type": "object",
  "required": ["token", "type", "usuario"],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "Bearer"
    },
    "usuario": {
      "type": "object",
      "required": ["usuario", "email", "status", "dataCriacao"],
      "properties": {
        "usuario": { "type": "string" },
        "email": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["ATIVO", "INATIVO", "BLOQUEADO"]
        },
        "dataCriacao": { "type": "string" }
      }
    }
  }
}
